<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 일기 음성: 앱이 마이크를 듣고 Pleos 음성 인식(기기 안 모드)에 전달 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 차 상태: 기어·운행(CAR_DRIVE), 와이퍼(CAR_WINDOWS), 좌석 감지(CAR_SEATS) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />

    <!-- 내비 연동: 현재 위치, 내비 화면 열기 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 길 위의 한마디: GPS 위치로 가까이 온 이야기를 띄우고, 내비 위에서는 알림으로 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|density|orientation|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 글레오: "글레오, 일기 쓰자" -->
            <intent-filter>
                <action android:name="START_DIARY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
